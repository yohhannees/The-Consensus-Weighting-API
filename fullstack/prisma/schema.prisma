generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Allocation {
  id        String   @id @default(cuid())
  userId    String
  targetId  String
  amount    Decimal  @db.Decimal(18, 2)
  createdAt DateTime @default(now())

  @@index([targetId])
  @@index([userId, targetId])
}

// Records an Idempotency-Key from a POST /api/allocations/weights request once its
// allocations have been persisted. A retried request with the same key hits this table's
// unique constraint, so the route can detect "already processed" and skip re-inserting —
// without this, a network retry after an uncertain response could double-count allocations.
model ProcessedRequest {
  id             String   @id @default(cuid())
  idempotencyKey String   @unique
  createdAt      DateTime @default(now())
}
